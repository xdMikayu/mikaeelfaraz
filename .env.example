# Copy to .env.local for local dev; set the same variables in Netlify
# (Site configuration → Environment variables). Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# Your Supabase Auth user id (shown on /finance/setup after you sign in)
FINANCE_OWNER_USER_ID=

# Long random secret used by iPhone Shortcuts, the Gmail script and the scheduled job.
# Generate with: openssl rand -hex 32
FINANCE_INGEST_TOKEN=

# Optional: AI categorization + summaries
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5   (default; set e.g. claude-sonnet-5 for a larger model)
