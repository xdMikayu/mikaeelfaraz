# Copy to .env.local for local dev; set the same variables in Netlify
# (Site configuration → Environment variables). Never commit real values.

# Optional: gameweek advice and chat (Matchday).
ANTHROPIC_API_KEY=
# MATCHDAY_AI_MODEL=claude-sonnet-5-5   (Matchday advice; default; claude-haiku-5-5 is cheaper)
# ADVICE_DAILY_LIMIT=200               (Matchday advice calls per day, per function instance)
# Matchday AI's news checks (press conferences, injuries) use the API's web search on the same key
# (an admin can switch web search on or off in the Anthropic Console under Settings → Capabilities):
# MATCHDAY_NEWS_MODEL=claude-haiku-5-5  (default; falls back to Sonnet 5.5 if it can't search)
# MATCHDAY_NEWS_SEARCHES=3              (web searches per club check, $0.01 each)
# ADVICE_NEWS_CLUBS=4                   (clubs checked per advice)
# NEWS_DAILY_LIMIT=120                  (club checks per day, per function instance)
