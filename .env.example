# Copy to .env.local for local dev; set the same variables in Netlify
# (Site configuration → Environment variables). Never commit real values.

# Matchday AI: the gameweek advice, the transfer chat and the news checks. Without a key those parts
# say they're switched off and everything else works.
ANTHROPIC_API_KEY=
# MATCHDAY_AI_MODEL=claude-sonnet-5-5   (advice and chat; default; claude-haiku-5-5 is cheaper)
# MATCHDAY_CHAT_EFFORT=medium           (low, medium or high)
# ADVICE_DAILY_LIMIT=200                (advice calls per day, per function instance)
# CHAT_DAILY_LIMIT=400                  (chat answers per day, per function instance)
# The news checks (press conferences, injuries) use the API's web search on the same key
# (an admin can switch web search on or off in the Anthropic Console under Settings → Capabilities):
# MATCHDAY_NEWS_MODEL=claude-haiku-5-5  (default; falls back to Sonnet 5.5 if it can't search)
# MATCHDAY_NEWS_SEARCHES=3              (web searches per club check, $0.01 each)
# ADVICE_NEWS_CLUBS=4                   (clubs checked per advice)
# NEWS_DAILY_LIMIT=120                  (club checks per day, per function instance)

# F1 live timing falls back to OpenF1 if F1's free feed fails; its live data needs a paid account.
# OPENF1_USERNAME=
# OPENF1_PASSWORD=
# Testing only: F1_DATA_URL reads the session files from somewhere other than this repo's f1-data
# branch, F1_LIVE_URL plays a recorded session (scripts/f1-replay.mjs) as if it were live.
# F1_DATA_URL=
# F1_LIVE_URL=
