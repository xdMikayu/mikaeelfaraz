# Copy to .env.local for local dev; set the same variables in Netlify
# (Site configuration → Environment variables). Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# Your Supabase Auth user id (shown on /finance/setup after you sign in)
FINANCE_OWNER_USER_ID=

# Long random secret used by iPhone Shortcuts, the Gmail script and the scheduled job.
# Generate with: openssl rand -hex 32
FINANCE_INGEST_TOKEN=

# Optional: AI categorization + summaries (Mifolio) and gameweek advice (Matchday). One key for both.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5   (Mifolio; default; set e.g. claude-sonnet-5 for a larger model)
# MATCHDAY_AI_MODEL=claude-sonnet-5-5   (Matchday; default; claude-haiku-5-5 is cheaper)
# ADVICE_DAILY_LIMIT=200               (Matchday advice calls per day, per function instance)
